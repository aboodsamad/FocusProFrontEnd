<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuration for FocusProAccessibilityService.

    eventTypes="typeWindowStateChanged"  — fires whenever the user opens a
        different app or navigates to a new screen inside an app.

    feedbackType="feedbackGeneric"  — we don't read text aloud or vibrate;
        we just observe silently.

    canRetrieveWindowContent="false"  — we only need the package/class name,
        not the full UI tree. Keeping this false is less invasive and faster.

    notificationTimeout="100"  — minimum ms between successive events (100ms
        is fast enough to feel instant without hammering the CPU).
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/accessibility_service_description" />
